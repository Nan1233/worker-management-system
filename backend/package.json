{
  "name": "backend",
  "version": "1.9.13",
  "description": "KTC internal production reporting API optimized for Render and TiDB",
  "main": "server.js",
  "scripts": {
    "prestart": "npm install",
    "start": "node --expose-gc server.js",
    "worker": "node worker.js",
    "dev": "nodemon server.js",
    "check": "node --check server.js && node scripts/checkSource.js",
    "db:indexes": "node scripts/ensureIndexes.js",
    "db:analyze": "node scripts/analyzeTables.js",
    "test": "node --test tests/*.test.js",
    "verify": "npm run check && npm test",
    "backup:db": "node scripts/createDatabaseBackup.js",
    "backup:verify": "node scripts/verifyDatabaseBackup.js",
    "restore:db": "node scripts/restoreDatabaseBackup.js",
    "db:demo-schema": "node scripts/ensureDemoSchema.js",
    "db:integrity": "node scripts/checkDatabaseIntegrity.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "validate:real-data": "node scripts/validateRealProductionData.js",
    "backup:drill": "node scripts/drillDatabaseBackup.js",
    "restore:rehearsal": "node scripts/rehearseDatabaseRestore.js",
    "load:readiness": "node scripts/loadReadiness.js",
    "audit:historical-standards": "node scripts/auditHistoricalStandards.js",
    "audit:training-snapshots": "node scripts/auditTrainingSnapshots.js",
    "audit:kqd": "node scripts/auditKqdSnapshots.js",
    "audit:shared-machines": "node scripts/auditSharedMachineAccounting.js",
    "audit:rollback-versions": "node scripts/auditRollbackVersions.js",
    "audit:logical-duplicates": "node scripts/auditLogicalDuplicates.js",
    "audit:worker-processes": "node scripts/auditWorkerProcesses.js",
    "audit:production-indexes": "node scripts/auditProductionIndexes.js"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "googleapis": "173.0.0",
    "helmet": "8.3.0",
    "ipaddr.js": "1.9.1",
    "jsonwebtoken": "9.0.3",
    "mysql2": "3.23.2"
  },
  "devDependencies": {
    "nodemon": "3.1.14"
  }
}
