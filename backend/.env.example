# KTC production uses Render -> TiDB Cloud.
# Never commit a real .env file or real credentials.

NODE_ENV=development
PORT=10000

DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=worker_management
DB_USER=
DB_PASSWORD=
DB_SSL=true
# Optional PEM CA. Leave empty when the Node/TiDB trust store is sufficient.
DB_SSL_CA=
DB_CONNECTION_LIMIT=6
DB_WORKER_CONNECTION_LIMIT=2
DB_WORKER_MAX_IDLE=1

# Frontend / mobile
CORS_ORIGINS=https://worker-management-system-3-dzox.onrender.com,https://localhost,capacitor://localhost
JWT_SECRET=

# Excel / integrations
ENABLE_PROCESS_EXCEL_EXPORT=true
ENABLE_SERVER_COMPANY_EXCEL=false
ENABLE_SERVER_HEAVY_EXCEL=false
EXCEL_DETAIL_BATCH_SIZE=400
EXCEL_EXPORT_RETENTION_MS=2592000000
EXCEL_JOB_TIMEOUT_MS=240000
EXCEL_MAX_REPORTS_PER_DAY=350
EXCEL_MAX_REPORTS_PER_MONTH=5000
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT=

# Optional backup settings; use a secured admin workstation.
# KTC_BACKUP_DIR=C:\Users\User\Documents\KTC\Backup\Database
# KTC_BACKUP_ENCRYPTION_KEY=use-a-long-random-secret-and-store-it-in-a-password-manager
# KTC_BACKUP_CHUNK_SIZE=500
