NODE_ENV=production
PORT=3000

DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true
DB_CONNECTION_LIMIT=6
DB_MAX_IDLE=3
DB_IDLE_TIMEOUT=60000
DB_QUEUE_LIMIT=100
DB_CONNECT_TIMEOUT=15000
DB_KEEP_ALIVE_DELAY=10000

JWT_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGINS=http://localhost:5173,https://worker-management-system-3-dzox.onrender.com
API_RATE_LIMIT=600
DASHBOARD_CACHE_TTL_MS=30000
INLINE_SYNC_TRIGGER=false

# Chỉ cho worker nhập/sửa báo cáo từ mạng công ty.
# Hỗ trợ nhiều IP hoặc CIDR, phân cách bằng dấu phẩy.
# Ví dụ: COMPANY_ALLOWED_IPS=113.160.10.20,14.225.0.0/24
COMPANY_ALLOWED_IPS=113.160.133.126

# Authentication session
ACCESS_TOKEN_EXPIRES_IN=7d
# Refresh session không tự hết hạn; biến cũ không còn được sử dụng.
# REFRESH_TOKEN_DAYS=30
