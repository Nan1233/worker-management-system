{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ktc-be-test",
  "main": "cloudflare-entrypoint.js",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "workers_dev": true,
  "keep_vars": true,
  "observability": { "enabled": true, "redact_query_string": true },
  "vars": {
    "KTC_RUN_BUILD_DB_MIGRATIONS": "false",
    "KTC_CLOUDFLARE_WORKER": "true",
    // Migrations are manual only (scripts/runPendingMigrations.js). The KTC_MIGRATION_* values below apply
    // solely to a manual run and are not read by the Worker at request time.
    "KTC_MIGRATION_REF": "test",
    "KTC_MIGRATION_REPOSITORY": "Nan1233/worker-management-system",
    // Ceiling for unattended migration. The runner may advance by itself only up
    // to this migration number and stops there; 031 onwards contain DELETE /
    // TRUNCATE / DROP against master data (046 clears the GC worker roster), so
    // they are deliberately held back. Raise this only after reviewing the next
    // migrations and taking a backup.
    "KTC_MIGRATION_MAX": "30",
    // Explicit allowlist beyond the ceiling: 053 only restores 6 GC deduction
    // types (idempotent status flip + guarded insert, no DELETE/DROP). The
    // ceiling stays at 30 so the destructive 031-052 migrations are NOT run.
    // 054 upserts GC machine C13 (no DELETE/DROP); 059 adds machines.gc_work_type
    // and backfills it only from seeded machine_name (idempotent, additive).
    // 060 only adds product_standards.encoding_code / production_reports.updated_by when missing
    // (ADD COLUMN IF NOT EXISTS; no PREPARE, no narrowing, no DELETE/DROP/TRUNCATE).
    "KTC_MIGRATION_INCLUDE": "53,54,59,60",
    // Test-only: lets /api/health/ready return missingTables/missingColumns so
    // DATABASE_CONTRACT_INVALID is diagnosable. Do not set on production.
    "KTC_EXPOSE_SCHEMA_DIAGNOSTICS": "true"
  }
}
