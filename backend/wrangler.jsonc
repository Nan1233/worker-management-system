{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ktc-be-test",
  "main": "cloudflare-entrypoint.js",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "workers_dev": true,
  "keep_vars": true,
  "observability": { "enabled": true },
  "limits": {
    "subrequests": 10000
  },
  "vars": {
    "KTC_RUN_BUILD_DB_MIGRATIONS": "true",
    "KTC_CLOUDFLARE_WORKER": "true",
    "KTC_MIGRATION_REF": "test",
    "KTC_MIGRATION_REPOSITORY": "Nan1233/worker-management-system"
  }
}
