{
  "name": "worker-management-system",
  "version": "1.9.7",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install && npm --prefix desktop install",
    "verify": "npm run verify:release-contract && npm run verify:release-consistency && npm run verify:excel-contract && npm --prefix backend run verify && npm --prefix frontend run check && npm --prefix desktop run check && npm --prefix desktop run smoke:excel",
    "build:web": "npm --prefix frontend run build",
    "build:exe": "npm --prefix desktop run dist:win",
    "validate:real-data": "npm --prefix backend run validate:real-data",
    "db:integrity": "npm --prefix backend run db:integrity",
    "backup:db": "npm --prefix backend run backup:db",
    "backup:drill": "npm --prefix backend run backup:drill --",
    "audit:prod": "npm --prefix frontend run audit:prod && npm --prefix backend run audit:prod && npm --prefix desktop run audit:prod",
    "restore:rehearsal": "npm --prefix backend run restore:rehearsal --",
    "load:readiness": "npm --prefix backend run load:readiness",
    "pilot:readiness": "node scripts/pilotReadiness.cjs",
    "build:mac": "npm --prefix desktop run dist:mac",
    "desktop:preflight": "npm --prefix desktop run preflight",
    "desktop:field-readiness": "npm --prefix desktop run field:readiness",
    "android:add": "npm --prefix frontend run android:add",
    "android:sync": "npm --prefix frontend run android:sync",
    "android:open": "npm --prefix frontend run android:open",
    "build:android": "npm --prefix frontend run android:apk:debug",
    "build:android:aab": "npm --prefix frontend run android:aab:release",
    "verify:excel-contract": "node scripts/excelStabilityContract.cjs",
    "install:clean": "npm ci --prefix backend && npm ci --prefix frontend && npm ci --prefix desktop",
    "verify:release-contract": "node scripts/releaseGateContract.cjs",
    "release:db": "npm --prefix backend run db:release",
    "restore:db": "npm --prefix backend run restore:db --",
    "restore:dry-run": "npm --prefix backend run restore:dry-run --",
    "restore:cutover-check": "npm --prefix backend run restore:cutover-check --",
    "restore:cutover-record": "npm --prefix backend run restore:cutover-record --",
    "restore:rollback-check": "npm --prefix backend run restore:rollback-check --",
    "restore:rollback-record": "npm --prefix backend run restore:rollback-record --",
    "restore:cleanup-check": "npm --prefix backend run restore:cleanup-check --",
    "validate:zero-cost": "node scripts/zero-cost/collect-report.cjs",
    "validate:zero-cost:seed": "node scripts/zero-cost/seed-ci.cjs",
    "validate:zero-cost:e2e": "node scripts/zero-cost/critical-e2e.cjs",
    "validate:zero-cost:security": "node scripts/zero-cost/security-runner.cjs",
    "validate:zero-cost:perf": "node scripts/zero-cost/perf-load-runner.cjs",
    "validate:zero-cost:excel": "node scripts/zero-cost/excel-runtime-runner.cjs",
    "verify:release-consistency": "node scripts/releaseConsistencyContract.cjs",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "verify:repo": "node scripts/checkRepository.cjs",
    "verify:quality": "npm run verify:repo && npm run verify"
  }
}
