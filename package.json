{
  "name": "frontend",
  "private": true,
  "version": "1.8.22",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && tsc -b && vite build && npm run check:bundle",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:theme && npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --test tests/*.test.cjs",
    "check:bundle": "node scripts/checkBundleSize.cjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check:theme": "node scripts/checkThemeContract.cjs",
    "verify:release-contract": "node scripts/releaseGateContract.cjs",
    "verify:release-consistency": "node scripts/releaseConsistencyContract.cjs",
    "verify:excel-contract": "node scripts/excelStabilityContract.cjs",
    "verify:repository": "node scripts/checkRepository.cjs",
    "validate:zero-cost": "node scripts/zero-cost/collect-report.cjs",
    "validate:zero-cost:seed": "node scripts/zero-cost/seed-ci.cjs",
    "validate:zero-cost:security": "node scripts/zero-cost/security-runner.cjs",
    "validate:zero-cost:e2e": "node scripts/zero-cost/critical-e2e.cjs",
    "validate:zero-cost:perf": "node scripts/zero-cost/perf-load-runner.cjs",
    "validate:zero-cost:excel": "node scripts/zero-cost/excel-runtime-runner.cjs",
    "android:add": "npm run android:prepare && cap add android",
    "android:sync": "npm run android:prepare && npm run build:native && cap sync android",
    "android:open": "npm run android:prepare && cap open android",
    "android:apk:debug": "npm run android:prepare && npm run build:native && cap sync android && cd android && gradlew.bat assembleDebug",
    "android:aab:release": "npm run android:prepare && npm run build:native && cap sync android && cd android && gradlew.bat bundleRelease",
    "android:prepare": "npm install --no-save --package-lock=false @capacitor/core@8.5.0 @capacitor/android@8.5.0 @capacitor/cli@8.5.0",
    "build:native": "node scripts/buildNative.cjs",
    "ios:add": "npm run ios:prepare && cap add ios",
    "ios:sync": "npm run ios:prepare && npm run build:native && cap sync ios",
    "ios:open": "npm run ios:prepare && cap open ios",
    "ios:prepare": "npm install --no-save --package-lock=false @capacitor/core@8.5.0 @capacitor/ios@8.5.0 @capacitor/cli@8.5.0",
    "ios:doctor": "npm run ios:prepare && cap doctor",
    "ios:doctor:production": "npm --prefix frontend run ios:doctor:production",
    "android:release:check": "npm --prefix frontend run android:release:check",
    "restore:rehearsal": "node backend/scripts/rehearseDatabaseRestore.js",
    "load:readiness": "node backend/scripts/loadReadiness.js",
    "quality:all": "npm --prefix backend run test && npm --prefix frontend run test && node --test tests/*.test.cjs",
    "test:root": "node --test tests/*.test.cjs",
    "audit:excel:roundtrip": "node scripts/excelRoundTripContract.cjs",
    "audit:performance": "node scripts/performanceAudit.cjs",
    "audit:final": "node scripts/finalReleaseAudit.cjs",
    "audit:dependency:contract": "node scripts/dependencyReleaseContract.cjs",
    "audit:security": "node scripts/securityContract.cjs",
    "audit:release": "node scripts/releaseConsistencyContract.cjs",
    "audit:excel:stability": "node scripts/excelStabilityContract.cjs",
    "perf:benchmark": "node scripts/performanceBenchmark.cjs",
    "ios:release:check": "npm --prefix frontend run ios:release:check",
    "mobile:release:check": "npm run android:release:check && npm run ios:release:check",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "audit:dependencies:all": "npm audit --audit-level=high",
    "quality:final": "npm run audit:final && npm run audit:security && npm run audit:dependency:contract && npm run audit:release && npm run mobile:release:check && npm run audit:excel:stability && npm run audit:performance && npm run perf:benchmark && npm run audit:excel:roundtrip && npm run quality:all"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "axios": "1.18.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "6.30.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.1.4"
  }
}
