{
  "name": "worker-management-system",
  "version": "1.9.7",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install && npm --prefix desktop install",
    "verify": "npm --prefix backend run verify && npm --prefix frontend run check && npm --prefix desktop run check && npm --prefix desktop run smoke:excel",
    "build:web": "npm --prefix frontend run build",
    "build:exe": "npm --prefix desktop run dist:win",
    "validate:real-data": "npm --prefix backend run validate:real-data",
    "db:integrity": "npm --prefix backend run db:integrity",
    "backup:db": "npm --prefix backend run backup:db",
    "backup:drill": "npm --prefix backend run backup:drill --",
    "audit:prod": "npm --prefix frontend run audit:prod && npm --prefix backend run audit:prod",
    "restore:rehearsal": "npm --prefix backend run restore:rehearsal --",
    "load:readiness": "npm --prefix backend run load:readiness",
    "pilot:readiness": "node scripts/pilotReadiness.cjs",
    "build:mac": "npm --prefix desktop run dist:mac",
    "desktop:preflight": "npm --prefix desktop run preflight",
    "desktop:field-readiness": "npm --prefix desktop run field:readiness",
    "android:add": "npm --prefix frontend run android:add",
    "android:sync": "npm --prefix frontend run android:sync",
    "android:open": "npm --prefix frontend run android:open",
    "build:android": "npm --prefix frontend run android:apk:debug",
    "build:android:aab": "npm --prefix frontend run android:aab:release"
  }
}
