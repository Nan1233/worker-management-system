    "audit:security": "node scripts/securityContract.cjs",
    "audit:release": "node scripts/releaseConsistencyContract.cjs",
    "audit:excel:stability": "node scripts/excelStabilityContract.cjs",
    "perf:benchmark": "node scripts/performanceBenchmark.cjs",
    "ios:release:check": "npm --prefix frontend run ios:release:check",
    "mobile:release:check": "npm run android:release:check && npm run ios:release:check",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "audit:dependencies:all": "npm audit --audit-level=high",
    "audit:dependency:contract": "node scripts/dependencyReleaseContract.cjs",
    "audit:source:consistency": "node scripts/sourceConsistencyContract.cjs",
