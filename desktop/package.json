{
  "name": "ktc-worker-management-desktop",
  "version": "1.0.5",
  "description": "KTC Worker Management System desktop application",
  "main": "electron/main.cjs",
  "author": "KTC",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix frontend install",
    "dev": "concurrently \"npm --prefix frontend run dev\" \"wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "build:web": "npm --prefix frontend run build",
    "start": "npm run build:web && electron .",
    "dist:win": "npm run build:web && electron-builder --win nsis",
    "dist:dir": "npm run build:web && electron-builder --dir",
    "dist:portable": "npm run build:web && electron-builder --win portable"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "vn.ktc.worker.management",
    "productName": "KTC Production Control",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KTC-Production-Control-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KTC Production Control"
    }
  }
}
