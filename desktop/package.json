{
  "name": "ktc-production-control-desktop",
  "version": "1.1.0",
  "description": "KTC Production Control Desktop - FE33 đóng gói nội bộ và tự động đồng bộ Excel theo dữ liệu backend",
  "main": "electron/main.cjs",
  "author": "KTC",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "frontend:install": "npm --prefix frontend install",
    "build:frontend": "npm --prefix frontend run build",
    "start": "npm run build:frontend && electron .",
    "dist:win": "npm run build:frontend && electron-builder --win nsis portable",
    "dist:portable": "npm run build:frontend && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "vn.ktc.productioncontrol",
    "productName": "KTC Production Control",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KTC-Production-Control-${version}-${arch}.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KTC Production Control",
      "deleteAppDataOnUninstall": false
    }
  }
}
